ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://benson_app:benson-app-development-only@postgres:5432/benson_erp
MIGRATION_DATABASE_URL=postgresql+asyncpg://benson:benson-development-only@postgres:5432/benson_erp
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
READINESS_TIMEOUT_SECONDS=2
OTEL_SERVICE_NAME=benson-erp-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=1.0
WORKER_BATCH_SIZE=50
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=8
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=3600
SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
CORS_ORIGINS=http://benson-ai:5173
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.data/storage
STORAGE_SIGNED_URL_SECONDS=300

# Docker Compose uses these MinIO-compatible S3 values for the API service.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://benson-ai:9000
# S3_BUCKET=benson-erp
# S3_REGION=us-west-2
# S3_ACCESS_KEY=minio-development
# S3_SECRET_KEY=replace-me
# S3_ADDRESSING_STYLE=path

# Production Google Cloud Storage uses Application Default Credentials.
# STORAGE_BACKEND=gcs
# GCS_BUCKET=replace-with-private-production-bucket
# GCS_PROJECT=replace-with-google-cloud-project

# Employee identity provisioning. Use "google" with a domain-wide delegated
# service account in production. "mock" is development-only.
GOOGLE_DIRECTORY_PROVIDER=disabled
GOOGLE_DIRECTORY_SERVICE_ACCOUNT_JSON=
GOOGLE_DIRECTORY_DELEGATED_ADMIN=
GOOGLE_DIRECTORY_TIMEOUT_SECONDS=10

# Activation email delivery. Production requires "smtp" with TLS and a
# configured host/from address. "mock" captures messages in memory for tests.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Benson Enterprises
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
FRONTEND_URL=http://benson-ai:5173
EMPLOYEE_ACTIVATION_HOURS=24
EMPLOYEE_SUPPORT_DETAILS=Benson Enterprises support: (458) 723-0818

# Set by the production image. Leave empty for the separate Vite development server.
WEB_DIST_PATH=
